# 1. Copiar el template
cp .env.example .env

# 2. Editar con tus valores
nano .env

# 3. Los valores mínimos que debes completar:
#    AWS_PROFILE    → nombre del perfil configurado en ~/.aws/credentials
#    AWS_REGION     → región que vas a auditar
#    AWS_ACCOUNT_ID → account ID de la cuenta objetivo
#    AUDITOR_NAME   → tu nombre (aparece en el reporte)